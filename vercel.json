{
  "version": 2,
  "installCommand": "npm install",
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "index.html",
          "results.html",
          "og-image.png",
          "og-image.svg",
          "index.css",
          "home.js",
          "results.js",
          "law-api.js",
          "lib/**"
        ]
      }
    }
  ],
  "routes": [{ "src": "/(.*)", "dest": "/server.js" }]
}
